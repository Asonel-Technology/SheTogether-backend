NODE_ENV=development
PORT=4000
API_PREFIX=/api
LOG_LEVEL=info
TRUST_PROXY=1
# Comma-separated frontend origins allowed by CORS (empty = allow any origin in development only)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SWAGGER_ENABLED=true
RATE_LIMIT_ENABLED=true

# Neon: pooled connection for the app, direct connection for migrations
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require"

# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=change-me-change-me-change-me-change-me-1
OTP_SECRET=change-me-change-me-change-me-change-me-2
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
BCRYPT_ROUNDS=12
OTP_TTL_MINUTES=10
# DEV ONLY: return OTP codes in API responses so you can test verification/reset in Swagger. Never in production.
EXPOSE_DEV_OTP=true

TERMS_VERSION=2026-01
REQUIRE_VERIFIED_FOR_POSTING=false
# DEV: lets a single admin approve their own drafts. Set false in production (four-eyes review).
ALLOW_SELF_APPROVAL=true
COMMUNITY_SEGREGATE_MINORS=true
COMMUNITY_MIN_BAND_TO_POST=AGE_13_15
AUTO_HIDE_REPORT_THRESHOLD=3
ACCOUNT_DELETION_GRACE_DAYS=30

# AZURE AI FOUNDRY
OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RETRIEVAL AUGMENTED GENERATION (RAG)
RAG_TOP_K=5
RAG_MIN_SIMILARITY=0.30
RAG_FALLBACK_LANGUAGE=en

# CHAT PRIVACY
CHAT_RETAIN_MESSAGES=false
CHAT_RETENTION_DAYS=30

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_ROOT_FOLDER=she-together
MEDIA_VERIFY_UPLOADS=true

USSD_ENABLED=false
USSD_WEBHOOK_SECRET=
ANALYTICS_RETENTION_DAYS=365

# Used only by `npm run db:seed`
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_USERNAME=create-admin
SEED_ADMIN_PASSWORD=change-me-change-me
