{
  "name": "she-together-backend",
  "version": "1.0.0",
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.js",
    "start": "node src/server.js",
    "test": "node --test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:extras": "prisma db execute --file prisma/sql/extras.sql --schema prisma/schema.prisma",
    "db:seed": "node --env-file=.env prisma/seed.js",
    "db:studio": "prisma studio",
    "maintenance": "node --env-file=.env scripts/maintenance.js",
    "postinstall": "prisma generate"
  },
  "type": "module",
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "cloudinary": "^2.11.0",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^7.59.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "prisma": "^6.19.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2"
  },
  "description": "She Together \u2013 backend API (Express, Prisma, Neon PostgreSQL + pgvector, Swagger)",
  "private": true,
  "engines": {
    "node": ">=20.12"
  }
}